# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection
# If using local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/iata-cargo
# Optional override; defaults to the database in MONGODB_URI, or iata-cargo if omitted there.
MONGODB_DB_NAME=iata-cargo
# If using MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/iata-cargo?retryWrites=true&w=majority

# JWT Secret for Session Authentication
JWT_SECRET=iata-cargo-super-secret-jwt-key-2026

# CORS Origin
CORS_ORIGIN=*
